# L'adresse de l'API, vue DEPUIS le telephone.
#
# `localhost` ne marche PAS depuis un vrai appareil : pour lui, `localhost`
# c'est lui-meme. Mets l'adresse de ta machine sur le reseau local — celle que
# `python demarrer.py` affiche au demarrage.
#
#   VITE_API_URL=http://192.168.1.13:8000/api/v1
#
# Dans le navigateur du poste de developpement, localhost suffit.
VITE_API_URL=http://localhost:8000/api/v1


# Le fond de carte (D-142). Facultatif : sans rien, OpenFreeMap s'affiche sans
# cle. Voir frontend-web/.env.example pour le detail — le reglage est le meme,
# et une cle de tuiles n'est pas un secret.
VITE_STYLE_CARTE=
